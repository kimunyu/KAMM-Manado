    "fu_logs": {
      "title": "FollowUpLogs",
      "description": "Logs of follow up interactions with mediators",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "kd_med": { "type": "string" },
        "nama_mediator": { "type": "string" },
        "tgl_fu": { "type": "string" },
        "hasil_fu": { "type": "string" },
        "catatan_fu": { "type": "string" },
        "user_fu": { "type": "string" },
        "kd_ao": { "type": "string" },
        "kd_posko": { "type": "string" },
        "kd_cabang": { "type": "string" }
      },
      "required": ["id", "kd_med", "tgl_fu", "hasil_fu", "user_fu"]
    }
