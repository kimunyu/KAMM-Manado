    "users": {
      "title": "Users",
      "description": "User accounts and roles for authentication and RBAC",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "username": { "type": "string" },
        "nama": { "type": "string" },
        "role": { "type": "string" },
