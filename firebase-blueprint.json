{
  "entities": {
    "users": {
      "title": "Users",
      "description": "User accounts and roles for authentication and RBAC",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "username": { "type": "string" },
        "nama": { "type": "string" },
        "role": { "type": "string" },
        "kd_ao": { "type": "string" },
        "kd_cabang": { "type": "string" },
        "kd_posko": { "type": "string" },
        "status": { "type": "string" },
        "email": { "type": "string" },
        "password": { "type": "string" },
        "must_change_password": { "type": "boolean" },
        "last_password_change": { "type": "string" }
      },
      "required": ["id", "username", "nama", "role", "status"]
    },
    "cabang": {
      "title": "Cabang",
      "description": "Branch offices",
      "type": "object",
      "properties": {
