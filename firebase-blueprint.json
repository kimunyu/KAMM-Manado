    "users": {
      "title": "Users",
      "description": "User accounts and roles for authentication and RBAC",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "username": { "type": "string" },
        "nama": { "type": "string" },
        "role": { "type": "string" },
        "kd_ao": { "type": "string" },
        "kd_cabang": { "type": "string" },
        "kd_posko": { "type": "string" },
        "status": { "type": "string" },
        "email": { "type": "string" },
