        "nama_cabang": { "type": "string" },
        "wilayah": { "type": "string" }
      },
      "required": ["kd_cabang", "nama_cabang"]
    },
    "posko": {
      "title": "Posko",
      "description": "Operational sub-branches / poskos",
      "type": "object",
      "properties": {
        "kd_posko": { "type": "string" },
        "nama_posko": { "type": "string" },
        "kd_cabang": { "type": "string" }
      },
      "required": ["kd_posko", "nama_posko", "kd_cabang"]
    },
    "mediators": {
      "title": "Mediators",
      "description": "Mediator contract profiles and statuses",
      "type": "object",
      "properties": {
        "kd_med": { "type": "string" },
        "temp_id": { "type": "string" },
        "nama_mediator": { "type": "string" },
        "no_tlpn": { "type": "string" },
        "kd_cabang": { "type": "string" },
        "kd_posko": { "type": "string" },
        "kd_ao": { "type": "string" },
        "status": { "type": "string" },
        "tgl_akhir_fu": { "type": "string" },
        "created_at": { "type": "string" },
        "created_by_user": { "type": "string" },
        "created_by_role": { "type": "string" },
        "catatan_admin": { "type": "string" },
        "validated_at": { "type": "string" },
        "validated_by": { "type": "string" }
      },
      "required": ["kd_med", "nama_mediator", "no_tlpn", "status", "kd_cabang"]
