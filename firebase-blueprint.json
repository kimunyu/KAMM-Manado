  "firestore": {
    "users": {
      "entity": "users",
      "description": "User accounts collection"
    },
    "cabang": {
      "entity": "cabang",
      "description": "Cabang collection"
    },
    "posko": {
      "entity": "posko",
      "description": "Posko collection"
    },
    "mediators": {
      "entity": "mediators",
      "description": "Mediators collection"
    },
    "fu_logs": {
      "entity": "fu_logs",
      "description": "Follow up logs collection"
    }
  }
