rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================================
    // HELPER FUNCTIONS (Single Source of Truth & Zero Privilege Escalation)
    // =========================================================================

    function isAuthenticated() {
      return request.auth != null;
    }

    function hasUserAuthMapping() {
      return isAuthenticated() && exists(/databases/$(database)/documents/user_auth/$(request.auth.uid));
    }

    function getUserAuthDoc() {
      return get(/databases/$(database)/documents/user_auth/$(request.auth.uid)).data;
    }

    function getResolvedUserId() {
      return hasUserAuthMapping() ? getUserAuthDoc().get('user_id', '') : request.auth.uid;
    }

    function hasResolvedUserDoc() {
      return isAuthenticated() && (
        (hasUserAuthMapping() && getUserAuthDoc().get('status', '') == 'AKTIF' && exists(/databases/$(database)/documents/users/$(getUserAuthDoc().user_id))) ||
        exists(/databases/$(database)/documents/users/$(request.auth.uid))
      );
    }

    function getUserDoc() {
      return get(/databases/$(database)/documents/users/$(getResolvedUserId())).data;
    }

    function isRegisteredAndActive() {
      return hasResolvedUserDoc() && getUserDoc().get('status', '') == 'AKTIF';
    }

    function getUserRole() {
      return isRegisteredAndActive() ? getUserDoc().get('role', '') : '';
    }

    function getUserId() {
      return getResolvedUserId();
    }

    function getUserCabang() {
      return isRegisteredAndActive() ? getUserDoc().get('kd_cabang', '') : '';
    }

    function getUserPosko() {
      return isRegisteredAndActive() ? getUserDoc().get('kd_posko', '') : '';
    }

    function getUserAO() {
      return isRegisteredAndActive() ? getUserDoc().get('kd_ao', '') : '';
    }

    function isSuperAdmin() {
      return getUserRole() == 'SUPER_ADMIN';
    }

    function isRM() {
      return getUserRole() == 'RM';
    }

    function isKaops() {
      return getUserRole() == 'KAOPS';
    }

    function isKacab() {
      return getUserRole() == 'KACAB';
    }

    function isKapos() {
      return getUserRole() == 'KAPOS';
    }

    function isAdm() {
      return getUserRole() == 'ADM';
    }

    function isCmo() {
      return getUserRole() == 'CMO';
    }

    function isAdminBpkb() {
      return getUserRole() == 'ADMIN_BPKB';
    }

    // =========================================================================
    // 1. MASTER DATA: USERS & USER_AUTH
    // =========================================================================

    match /users/{userId} {
      allow read: if isRegisteredAndActive() || isAuthenticated();
      allow create: if isSuperAdmin() && request.resource.data.id == userId;
      allow update: if (isSuperAdmin() && request.resource.data.id == resource.data.id)
                    || (
                      // Self-linking firebase_uid on initial login with zero privilege escalation
                      isAuthenticated() &&
                      request.resource.data.id == resource.data.id &&
                      request.resource.data.role == resource.data.role &&
                      request.resource.data.status == resource.data.status &&
                      request.resource.data.get('username', '') == resource.data.get('username', '') &&
                      request.resource.data.get('kd_cabang', '') == resource.data.get('kd_cabang', '') &&
                      request.resource.data.get('kd_posko', '') == resource.data.get('kd_posko', '') &&
                      request.resource.data.get('kd_ao', '') == resource.data.get('kd_ao', '') &&
                      request.resource.data.firebase_uid == request.auth.uid &&
                      (
                        request.auth.token.email == resource.data.get('email', '') ||
                        request.auth.token.email == resource.data.get('username', '') + '@kamm-manado.internal' ||
                        request.auth.token.email == resource.data.get('username', '') + '@perusahaan.co.id'
                      )
                    );
      allow delete: if isSuperAdmin();
    }

    match /user_auth/{firebaseUid} {
      allow read: if isRegisteredAndActive() || (isAuthenticated() && request.auth.uid == firebaseUid);
      allow create, update: if isSuperAdmin() || (
        isAuthenticated() && 
        request.auth.uid == firebaseUid &&
        exists(/databases/$(database)/documents/users/$(request.resource.data.user_id)) &&
        get(/databases/$(database)/documents/users/$(request.resource.data.user_id)).data.status == 'AKTIF' &&
        request.resource.data.status == 'AKTIF' &&
        (
          request.auth.token.email == get(/databases/$(database)/documents/users/$(request.resource.data.user_id)).data.get('email', '') ||
          request.auth.token.email == get(/databases/$(database)/documents/users/$(request.resource.data.user_id)).data.get('username', '') + '@kamm-manado.internal' ||
          request.auth.token.email == get(/databases/$(database)/documents/users/$(request.resource.data.user_id)).data.get('username', '') + '@perusahaan.co.id'
        )
      );
      allow delete: if isSuperAdmin();
    }

    // =========================================================================
    // 2. MASTER DATA: CABANG & POSKO
    // =========================================================================

    match /cabang/{kdCabang} {
      allow read: if isRegisteredAndActive();
      allow create: if isSuperAdmin() && request.resource.data.kd_cabang == kdCabang;
      allow update: if isSuperAdmin() && request.resource.data.kd_cabang == resource.data.kd_cabang;
      allow delete: if isSuperAdmin();
    }

    match /posko/{kdPosko} {
      allow read: if isRegisteredAndActive();
      allow create: if isSuperAdmin() && request.resource.data.kd_posko == kdPosko;
      allow update: if isSuperAdmin() && request.resource.data.kd_posko == resource.data.kd_posko;
      allow delete: if isSuperAdmin();
    }

// =========================================================================
// 3. MODUL MEDIATOR & FOLLOW-UP
//    HARD BLOCK ADMIN_BPKB / RM / KACAB
// =========================================================================

// -------------------------------------------------------------------------
// CMO MEDIATOR CREATE — ISOLATED PREDICATE
//
// Identity chain:
// request.auth.uid
//      ↓
// user_auth/{uid}
//      ↓
// users/{user_id}
//
// Hanya dua dokumen identitas yang diperlukan:
//   1. user_auth/{uid}
//   2. users/{user_id}
//
// Jangan menambahkan get()/exists() lain ke predicate ini.
// -------------------------------------------------------------------------

function isCmoMediatorCreateAllowed() {
  return isAuthenticated()

    // ---------------------------------------------------------------
    // 1. Mapping Firebase UID -> internal user
    // ---------------------------------------------------------------
    && exists(
      /databases/$(database)/documents/user_auth/$(request.auth.uid)
    )

    && get(
      /databases/$(database)/documents/user_auth/$(request.auth.uid)
    ).data.get('status', '') == 'AKTIF'

    // ---------------------------------------------------------------
    // 2. Master user harus tersedia
    // ---------------------------------------------------------------
    && exists(
      /databases/$(database)/documents/users/$(
        get(
          /databases/$(database)/documents/user_auth/$(request.auth.uid)
        ).data.get('user_id', '')
      )
    )

    // ---------------------------------------------------------------
    // 3. Master user harus AKTIF + role CMO
    // ---------------------------------------------------------------
    && get(
      /databases/$(database)/documents/users/$(
        get(
          /databases/$(database)/documents/user_auth/$(request.auth.uid)
        ).data.get('user_id', '')
      )
    ).data.get('status', '') == 'AKTIF'

    && get(
      /databases/$(database)/documents/users/$(
        get(
          /databases/$(database)/documents/user_auth/$(request.auth.uid)
        ).data.get('user_id', '')
      )
    ).data.get('role', '') == 'CMO'

    // ---------------------------------------------------------------
    // 4. Scope mediator HARUS sama dengan scope CMO
    // ---------------------------------------------------------------
    && request.resource.data.get('kd_cabang', '') ==
       get(
         /databases/$(database)/documents/users/$(
           get(
             /databases/$(database)/documents/user_auth/$(request.auth.uid)
           ).data.get('user_id', '')
         )
       ).data.get('kd_cabang', '')

    && request.resource.data.get('kd_posko', '') ==
       get(
         /databases/$(database)/documents/users/$(
           get(
             /databases/$(database)/documents/user_auth/$(request.auth.uid)
           ).data.get('user_id', '')
         )
       ).data.get('kd_posko', '')

    && request.resource.data.get('kd_ao', '') ==
       get(
         /databases/$(database)/documents/users/$(
           get(
             /databases/$(database)/documents/user_auth/$(request.auth.uid)
           ).data.get('user_id', '')
         )
       ).data.get('kd_ao', '')

    // ---------------------------------------------------------------
    // 5. CMO hanya boleh CREATE mediator BELUM_AKTIF
    // ---------------------------------------------------------------
    && request.resource.data.get('status', '') == 'BELUM_AKTIF';
}


// =========================================================================
// MATCH MEDIATORS
// =========================================================================

match /mediators/{kdMed} {

  // -----------------------------------------------------------------------
  // CREATE
  // -----------------------------------------------------------------------
  // ADMIN_BPKB, RM, dan KACAB TIDAK BOLEH MEMBUAT MEDIATOR.
  //
  // CMO menggunakan isolated predicate di atas.
  // Jalur lainnya tetap menggunakan authorization lama.
  // -----------------------------------------------------------------------

  allow create: if

    // ===============================================================
    // CMO — ISOLATED PATH
    // ===============================================================
    isCmoMediatorCreateAllowed()

    ||

    // ===============================================================
    // EXISTING NON-CMO AUTHORIZATION PATHS
    // ===============================================================
    (
      isRegisteredAndActive()

      && !isAdminBpkb()
      && !isRM()
      && !isKacab()

      && (
        // -----------------------------------------------------------
        // SUPER ADMIN
        // -----------------------------------------------------------
        isSuperAdmin()

        ||

        // -----------------------------------------------------------
        // KAOPS
        // -----------------------------------------------------------
        (
          isKaops()
          && request.resource.data.get('kd_cabang', '') ==
             getUserCabang()
          && request.resource.data.get('status', '') ==
             'BELUM_AKTIF'
        )

        ||

        // -----------------------------------------------------------
        // KAPOS
        // -----------------------------------------------------------
        (
          isKapos()
          && request.resource.data.get('kd_cabang', '') ==
             getUserCabang()
          && request.resource.data.get('kd_posko', '') ==
             getUserPosko()
          && request.resource.data.get('status', '') ==
             'BELUM_AKTIF'
        )

        ||

        // -----------------------------------------------------------
        // ADM
        // -----------------------------------------------------------
        (
          isAdm()
          && request.resource.data.get('kd_cabang', '') ==
             getUserCabang()
          && request.resource.data.get('kd_posko', '') ==
             getUserPosko()
          && request.resource.data.get('status', '') ==
             'BELUM_AKTIF'
        )
      )
    );

      // -----------------------------------------------------------------------
      // UPDATE
      // ADMIN_BPKB TIDAK BOLEH MENGUBAH DATA MEDIATOR
      // -----------------------------------------------------------------------
      allow update: if isRegisteredAndActive() && !isAdminBpkb() && (
        // SUPER ADMIN
        isSuperAdmin()

        // KAOPS
        || (
          isKaops()
          && resource.data.kd_cabang == getUserCabang()
          && request.resource.data.kd_cabang == resource.data.kd_cabang
          && request.resource.data.status in ['BELUM_AKTIF', 'PENDING', 'AKTIF', 'DITOLAK']
        )

        // KAPOS
        || (
          isKapos()
          && resource.data.kd_cabang == getUserCabang()
          && resource.data.kd_posko == getUserPosko()
          && (
            (resource.data.status == 'BELUM_AKTIF' && request.resource.data.status in ['BELUM_AKTIF', 'DITOLAK']) ||
            (resource.data.status == 'PENDING' && request.resource.data.status in ['AKTIF', 'DITOLAK', 'PENDING'])
          )
        )

        // ADM
        || (
          isAdm()
          && resource.data.kd_cabang == getUserCabang()
          && resource.data.kd_posko == getUserPosko()
          && (
            (resource.data.status == 'BELUM_AKTIF' && request.resource.data.status in ['PENDING', 'DITOLAK', 'BELUM_AKTIF']) ||
            (resource.data.status == 'PENDING' && request.resource.data.status in ['PENDING', 'DITOLAK'])
          )
        )

        // CMO
        || (
          isCmo()
          && resource.data.kd_cabang == getUserCabang()
          && resource.data.kd_posko == getUserPosko()
          && resource.data.kd_ao == getUserAO()
          && resource.data.status == 'BELUM_AKTIF'
          && request.resource.data.status == 'BELUM_AKTIF'
        )
      ) && (
        (!('created_at' in resource.data) || request.resource.data.created_at == resource.data.created_at) &&
        (!('created_by_user' in resource.data) || request.resource.data.created_by_user == resource.data.created_by_user) &&
        (!('created_by_role' in resource.data) || request.resource.data.created_by_role == resource.data.created_by_role)
      );

      // -----------------------------------------------------------------------
      // DELETE
      // ADMIN_BPKB TIDAK BOLEH MENGHAPUS DATA MEDIATOR
      // -----------------------------------------------------------------------
      allow delete: if isSuperAdmin()
                    ||
                    (
                      isRegisteredAndActive()
                      && !isAdminBpkb()
                      && resource.data.status in ['BELUM_AKTIF', 'PENDING']
                      && (
                        (isKaops() && resource.data.kd_cabang == getUserCabang()) ||
                        (isKapos() && resource.data.kd_cabang == getUserCabang() && resource.data.kd_posko == getUserPosko()) ||
                        (isAdm() && resource.data.kd_cabang == getUserCabang() && resource.data.kd_posko == getUserPosko())
                      )
                    );
    }

    // =========================================================================
    // FOLLOW-UP LOGS
    // =========================================================================

    match /fu_logs/{logId} {
      allow read: if isRegisteredAndActive() && !isAdminBpkb();

      allow create: if isRegisteredAndActive() && !isAdminBpkb() && !isRM() && !isKacab() && (
        isSuperAdmin() ||
        (isKaops() && request.resource.data.kd_cabang == getUserCabang()) ||
        (isKapos() && request.resource.data.kd_cabang == getUserCabang() && request.resource.data.kd_posko == getUserPosko()) ||
        (isAdm() && request.resource.data.kd_cabang == getUserCabang() && request.resource.data.kd_posko == getUserPosko()) ||
        (isCmo() && request.resource.data.kd_ao == getUserAO())
      );

      allow update, delete: if isSuperAdmin();
    }

    // =========================================================================
    // 4. MODUL EX-CUSTOMER & BPKB
    // =========================================================================

    match /ex_customers/{noPsb} {
      allow read: if isRegisteredAndActive();
      allow create: if isRegisteredAndActive() && (isSuperAdmin() || isAdminBpkb()) && request.resource.data.no_psb == noPsb;
      
      allow update: if isRegisteredAndActive() && !isRM() && !isKacab() && (
        isSuperAdmin() ||
        isAdminBpkb() ||
        (isKaops() && resource.data.kd_cab == getUserCabang() && request.resource.data.kd_cab == resource.data.kd_cab) ||
        (isKapos() && resource.data.kd_cab == getUserCabang() && resource.data.kd_pos == getUserPosko() && request.resource.data.kd_cab == resource.data.kd_cab && request.resource.data.kd_pos == resource.data.kd_pos) ||
        (isAdm() && resource.data.kd_cab == getUserCabang() && resource.data.kd_pos == getUserPosko() && request.resource.data.kd_cab == resource.data.kd_cab && request.resource.data.kd_pos == resource.data.kd_pos) ||
        (isCmo() && (
          resource.data.assigned_to_cmo_id == getUserId() &&
          request.resource.data.assigned_to_cmo_id == resource.data.assigned_to_cmo_id &&
          request.resource.data.kd_cab == resource.data.kd_cab &&
          request.resource.data.kd_pos == resource.data.kd_pos
        ))
      ) && (
        request.resource.data.no_psb == resource.data.no_psb &&
        (!('created_at' in resource.data) || request.resource.data.created_at == resource.data.created_at) &&
        (!('created_by_uid' in resource.data) || request.resource.data.created_by_uid == resource.data.created_by_uid)
      );

      allow delete: if isSuperAdmin();
    }

    match /ex_customer_fu_logs/{logId} {
      allow read: if isRegisteredAndActive();
      allow create: if isRegisteredAndActive() && !isRM() && !isKacab() && (
        isSuperAdmin() ||
        isAdminBpkb() ||
        (isKaops() && request.resource.data.kd_cab == getUserCabang()) ||
        (isKapos() && request.resource.data.kd_cab == getUserCabang() && request.resource.data.kd_pos == getUserPosko()) ||
        (isAdm() && request.resource.data.kd_cab == getUserCabang() && request.resource.data.kd_pos == getUserPosko()) ||
        (isCmo() && request.resource.data.user_id == getUserId() && request.resource.data.kd_ao == getUserAO())
      );
      allow update, delete: if isSuperAdmin();
    }

    // =========================================================================
    // 5. GLOBAL DEFAULT DENY CATCH-ALL
    // =========================================================================

    match /{document=**} {
      allow read, write: if false;
    }
  }
}

