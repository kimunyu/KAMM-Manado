rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================================
    // HELPER FUNCTIONS (Single Source of Truth & Zero Privilege Escalation)
    // =========================================================================

    function isAuthenticated() {
      return request.auth != null;
    }

    function getResolvedUserId() {
      return exists(/databases/$(database)/documents/user_auth/$(request.auth.uid))
        ? get(/databases/$(database)/documents/user_auth/$(request.auth.uid)).data.get('user_id', request.auth.uid)
        : request.auth.uid;
    }

    function getUserDoc() {
      return get(/databases/$(database)/documents/users/$(getResolvedUserId())).data;
    }

    function hasResolvedUserDoc() {
      return isAuthenticated() && exists(/databases/$(database)/documents/users/$(getResolvedUserId()));
    }

    function isRegisteredAndActive() {
      return hasResolvedUserDoc() && getUserDoc().get('status', '') == 'AKTIF';
    }

    function getUserRole() {
      return getUserDoc().get('role', '');
    }

    function getUserId() {
      return getResolvedUserId();
    }

    function getUserCabang() {
      return getUserDoc().get('kd_cabang', '');
    }

    function getUserPosko() {
      return getUserDoc().get('kd_posko', '');
    }

    function getUserAO() {
      return getUserDoc().get('kd_ao', '');
    }

    function isSuperAdmin() {
      return getUserRole() == 'SUPER_ADMIN';
    }

    function isRM() {
      return getUserRole() == 'RM';
    }

    function isKaops() {
      return getUserRole() == 'KAOPS';
    }

    function isKacab() {
      return getUserRole() == 'KACAB';
    }

    function isKapos() {
      return getUserRole() == 'KAPOS';
    }

    function isAdm() {
      return getUserRole() == 'ADM';
    }

    function isCmo() {
      return getUserRole() == 'CMO';
    }

    function isAdminBpkb() {
      return getUserRole() == 'ADM_BPKB' || getUserRole() == 'ADMIN_BPKB';
    }

    function isAdmDe() {
      return getUserRole() == 'ADM_DE';
    }

    // =========================================================================
    // 1. MASTER DATA: USERS & USER_AUTH
    // =========================================================================

    match /users/{userId} {
      allow read: if isRegisteredAndActive() || isAuthenticated();
      allow create: if isSuperAdmin() && request.resource.data.id == userId;
      allow update: if (isSuperAdmin() && request.resource.data.id == resource.data.id)
                    || (
                      // Self-linking firebase_uid on login with zero privilege escalation
                      isAuthenticated() &&
                      request.resource.data.id == resource.data.id &&
                      request.resource.data.role == resource.data.role &&
                      request.resource.data.status == resource.data.status &&
                      request.resource.data.firebase_uid == request.auth.uid
                    );
      allow delete: if isSuperAdmin();
    }

    match /user_auth/{firebaseUid} {
      allow read: if isRegisteredAndActive() || (isAuthenticated() && request.auth.uid == firebaseUid);
      allow create, update: if isSuperAdmin() || (
        isAuthenticated() && 
        request.auth.uid == firebaseUid &&
        exists(/databases/$(database)/documents/users/$(request.resource.data.user_id)) &&
        get(/databases/$(database)/documents/users/$(request.resource.data.user_id)).data.status == 'AKTIF'
      );
      allow delete: if isSuperAdmin();
    }

    // =========================================================================
    // 2. MASTER DATA: CABANG & POSKO
    // =========================================================================

    match /cabang/{kdCabang} {
      allow read: if isRegisteredAndActive();
      allow create: if isSuperAdmin() && request.resource.data.kd_cabang == kdCabang;
      allow update: if isSuperAdmin() && request.resource.data.kd_cabang == resource.data.kd_cabang;
      allow delete: if isSuperAdmin();
    }

    match /posko/{kdPosko} {
      allow read: if isRegisteredAndActive();
      allow create: if isSuperAdmin() && request.resource.data.kd_posko == kdPosko;
      allow update: if isSuperAdmin() && request.resource.data.kd_posko == resource.data.kd_posko;
      allow delete: if isSuperAdmin();
    }

    // =========================================================================
    // 3. MODUL MEDIATOR & FOLLOW-UP
    // =========================================================================

    function isCmoMediatorCreateAllowed() {
      return isAuthenticated()
        && isRegisteredAndActive()
        && getUserRole() == 'CMO'
        && (getUserCabang() == '' || request.resource.data.get('kd_cabang', '') == getUserCabang())
        && (getUserPosko() == '' || request.resource.data.get('kd_posko', '') == getUserPosko())
        && (getUserAO() == '' || request.resource.data.get('kd_ao', '') == getUserAO())
        && request.resource.data.get('status', '') == 'BELUM_AKTIF';
    }

    match /mediators/{kdMed} {
      allow read: if isRegisteredAndActive() && !isAdminBpkb() && !isAdmDe();

      allow create: if isCmoMediatorCreateAllowed() || (
        isRegisteredAndActive() && !isAdminBpkb() && !isAdmDe() && !isRM() && !isKacab() && (
          isSuperAdmin() ||
          (
            isKaops() &&
            (getUserCabang() == '' || request.resource.data.get('kd_cabang', '') == getUserCabang()) &&
            request.resource.data.get('status', '') == 'BELUM_AKTIF'
          ) ||
          (
            isKapos() &&
            (getUserCabang() == '' || request.resource.data.get('kd_cabang', '') == getUserCabang()) &&
            (getUserPosko() == '' || request.resource.data.get('kd_posko', '') == getUserPosko() || request.resource.data.get('kd_posko', '') == '') &&
            request.resource.data.get('status', '') == 'BELUM_AKTIF'
          ) ||
          (
            isAdm() &&
            (getUserCabang() == '' || request.resource.data.get('kd_cabang', '') == getUserCabang()) &&
            request.resource.data.get('status', '') == 'BELUM_AKTIF'
          )
        )
      );

      allow update: if isRegisteredAndActive() && !isAdminBpkb() && !isAdmDe() && (
        isSuperAdmin() ||
        (
          isKaops() &&
          (getUserCabang() == '' || resource.data.get('kd_cabang', '') == getUserCabang()) &&
          request.resource.data.status in ['BELUM_AKTIF', 'PENDING', 'AKTIF', 'INAKTIF', 'DITOLAK']
        ) ||
        (
          isKapos() &&
          (getUserCabang() == '' || resource.data.get('kd_cabang', '') == getUserCabang()) &&
          (
            getUserPosko() == '' ||
            resource.data.get('kd_posko', '') == getUserPosko() ||
            resource.data.get('kd_posko', '') == '' ||
            request.resource.data.get('kd_posko', '') == getUserPosko()
          ) &&
          request.resource.data.status in ['BELUM_AKTIF', 'PENDING', 'AKTIF', 'INAKTIF', 'DITOLAK']
        ) ||
        (
          isAdm() &&
          (getUserCabang() == '' || resource.data.get('kd_cabang', '') == getUserCabang()) &&
          request.resource.data.status in ['BELUM_AKTIF', 'PENDING', 'AKTIF', 'INAKTIF', 'DITOLAK']
        ) ||
        (
          isCmo() &&
          (getUserCabang() == '' || resource.data.get('kd_cabang', '') == getUserCabang()) &&
          (
            resource.data.get('kd_ao', '').lower() == getUserAO().lower() ||
            resource.data.get('created_by_user', '') == getUserId()
          ) &&
          resource.data.status == 'BELUM_AKTIF' &&
          request.resource.data.status == 'BELUM_AKTIF'
        ) ||
        (
          // Allow branch officers to update tgl_akhir_fu when logging follow-up
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['tgl_akhir_fu']) &&
          (getUserCabang() == '' || resource.data.get('kd_cabang', '') == getUserCabang())
        )
      ) && (
        isSuperAdmin() || (
          (!('created_at' in resource.data) || request.resource.data.get('created_at', '') == resource.data.get('created_at', ''))
        )
      );

      allow delete: if isSuperAdmin() || (
        isRegisteredAndActive() && !isAdminBpkb() && !isAdmDe() &&
        resource.data.status in ['BELUM_AKTIF', 'PENDING'] &&
        (
          (isKaops() && (getUserCabang() == '' || resource.data.get('kd_cabang', '') == getUserCabang())) ||
          (isKapos() && (getUserCabang() == '' || resource.data.get('kd_cabang', '') == getUserCabang()) && (resource.data.get('kd_posko', '') == getUserPosko() || resource.data.get('kd_posko', '') == '')) ||
          (isAdm() && (getUserCabang() == '' || resource.data.get('kd_cabang', '') == getUserCabang()))
        )
      );
    }

    match /fu_logs/{logId} {
      allow read: if isRegisteredAndActive() && !isAdminBpkb() && !isAdmDe();

      allow create: if isRegisteredAndActive() && !isAdminBpkb() && !isAdmDe() && !isRM() && !isKacab() && (
        isSuperAdmin() ||
        (isKaops() && (getUserCabang() == '' || request.resource.data.get('kd_cabang', '') == getUserCabang())) ||
        (isKapos() && (getUserCabang() == '' || request.resource.data.get('kd_cabang', '') == getUserCabang())) ||
        (isAdm() && (getUserCabang() == '' || request.resource.data.get('kd_cabang', '') == getUserCabang())) ||
        (isCmo() && (getUserAO() == '' || request.resource.data.get('kd_ao', '') == getUserAO()))
      );

      allow update, delete: if isSuperAdmin();
    }

    // =========================================================================
    // 4. MODUL EX-CUSTOMER & BPKB
    // =========================================================================

    match /ex_customers/{noPsb} {
      allow read: if isRegisteredAndActive() && !isAdmDe();
      allow create: if isRegisteredAndActive() && !isAdmDe() && (isSuperAdmin() || isAdminBpkb()) && request.resource.data.no_psb == noPsb;
      
      allow update: if isRegisteredAndActive() && !isAdmDe() && !isRM() && !isKacab() && (
        isSuperAdmin() ||
        isAdminBpkb() ||
        (isKaops() && (getUserCabang() == '' || resource.data.get('kd_cab', '') == '' || resource.data.get('kd_cab', '') == getUserCabang() || resource.data.get('cabang_id', '') == getUserCabang() || resource.data.get('kd_cabang', '') == getUserCabang())) ||
        (isKapos() && (
          getUserCabang() == '' || 
          resource.data.get('kd_cab', '') == '' || 
          resource.data.get('kd_cab', '') == getUserCabang() || 
          resource.data.get('cabang_id', '') == getUserCabang() || 
          resource.data.get('kd_cabang', '') == getUserCabang() ||
          resource.data.get('kd_pos', '') == getUserPosko() || 
          resource.data.get('posko_id', '') == getUserPosko() || 
          resource.data.get('kd_posko', '') == getUserPosko()
        )) ||
        (isAdm() && (getUserCabang() == '' || resource.data.get('kd_cab', '') == '' || resource.data.get('kd_cab', '') == getUserCabang() || resource.data.get('cabang_id', '') == getUserCabang() || resource.data.get('kd_cabang', '') == getUserCabang())) ||
        (isCmo() && (
          resource.data.get('assigned_to_cmo_id', '') == getUserId() &&
          request.resource.data.get('assigned_to_cmo_id', '') == resource.data.get('assigned_to_cmo_id', '')
        ))
      ) && (
        request.resource.data.no_psb == resource.data.no_psb &&
        (!('created_at' in resource.data) || request.resource.data.get('created_at', '') == resource.data.get('created_at', '')) &&
        (!('created_by_uid' in resource.data) || request.resource.data.get('created_by_uid', '') == resource.data.get('created_by_uid', ''))
      );

      allow delete: if isSuperAdmin();
    }

    match /ex_customer_fu_logs/{logId} {
      allow read: if isRegisteredAndActive() && !isAdmDe();
      allow create: if isRegisteredAndActive() && !isAdmDe() && !isRM() && !isKacab() && (
        isSuperAdmin() ||
        isAdminBpkb() ||
        (isKaops() && (getUserCabang() == '' || request.resource.data.get('kd_cab', '') == getUserCabang() || request.resource.data.get('kd_cabang', '') == getUserCabang())) ||
        (isKapos() && (getUserCabang() == '' || request.resource.data.get('kd_cab', '') == getUserCabang() || request.resource.data.get('kd_cabang', '') == getUserCabang())) ||
        (isAdm() && (getUserCabang() == '' || request.resource.data.get('kd_cab', '') == getUserCabang() || request.resource.data.get('kd_cabang', '') == getUserCabang())) ||
        (isCmo() && (request.resource.data.get('user_id', '') == getUserId() || request.resource.data.get('kd_ao', '') == getUserAO()))
      );
      allow update, delete: if isSuperAdmin();
    }

    // =========================================================================
    // 5. MODUL KONTROL SALES (Pencairan Konsumen & Verifikasi ADM_DE)
    // =========================================================================

    function canAccessSalesModule() {
      return isRegisteredAndActive() && (
        isSuperAdmin() || isRM() || isAdmDe() || isKacab() || isKaops() || isAdm() || isKapos()
      );
    }

    match /sales_control_records/{recordId} {
      allow read: if isRegisteredAndActive() && (
        isSuperAdmin() || isRM() || isAdmDe() ||
        (isKacab() && (getUserCabang() == '' || resource.data.get('cabang_id', '') == getUserCabang() || resource.data.get('kd_cabang', '') == getUserCabang())) ||
        (isKaops() && (getUserCabang() == '' || resource.data.get('cabang_id', '') == getUserCabang() || resource.data.get('kd_cabang', '') == getUserCabang())) ||
        (isKapos() && (
          getUserPosko() == '' ||
          resource.data.get('posko_id', '') == getUserPosko() ||
          resource.data.get('kd_posko', '') == getUserPosko()
        )) ||
        (isAdm() && (
          getUserCabang() == '' ||
          resource.data.get('cabang_id', '') == getUserCabang() ||
          resource.data.get('kd_cabang', '') == getUserCabang() ||
          resource.data.get('posko_id', '') == getUserPosko() ||
          resource.data.get('kd_posko', '') == getUserPosko()
        ))
      );

      allow create: if isRegisteredAndActive() && (
        isSuperAdmin() ||
        isAdmDe() ||
        (
          (isKaops() || isAdm() || isKapos()) &&
          (
            getUserCabang() == '' ||
            request.resource.data.get('cabang_id', '') == getUserCabang() ||
            request.resource.data.get('kd_cabang', '') == getUserCabang() ||
            request.resource.data.get('posko_id', '') == getUserPosko() ||
            request.resource.data.get('kd_posko', '') == getUserPosko()
          )
        )
      ) && (
        request.resource.data.get('id', '') == recordId ||
        request.resource.data.get('no_psb', '') == recordId
      );

      allow update: if isRegisteredAndActive() && (
        isSuperAdmin() ||
        isAdmDe() ||
        (
          (isKaops() || isAdm() || isKapos()) &&
          (
            getUserCabang() == '' ||
            resource.data.get('cabang_id', '') == getUserCabang() ||
            resource.data.get('kd_cabang', '') == getUserCabang() ||
            resource.data.get('posko_id', '') == getUserPosko() ||
            resource.data.get('kd_posko', '') == getUserPosko()
          )
        )
      ) && (
        request.resource.data.get('id', '') == recordId ||
        request.resource.data.get('no_psb', '') == recordId ||
        request.resource.data.get('id', '') == resource.data.get('id', '') ||
        request.resource.data.get('no_psb', '') == resource.data.get('no_psb', '')
      );

      allow delete: if isSuperAdmin();
    }

    // =========================================================================
    // 6. AUDIT TRAIL & SYSTEM LOGS (Authenticated audit log trail)
    // =========================================================================

    match /audit_logs/{logId} {
      allow read: if isRegisteredAndActive();
      allow create: if isRegisteredAndActive() || isAuthenticated();
      allow update: if false;
      allow delete: if isSuperAdmin();
    }

    // =========================================================================
    // 7. GLOBAL DEFAULT DENY CATCH-ALL
    // =========================================================================

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
