rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isRegisteredAndActive() {
      return isSignedIn() && getUserData().status == 'AKTIF';
    }

    function getUserRole() {
      return getUserData().role;
    }

    function isSuperAdmin() {
      return isRegisteredAndActive() && getUserRole() == 'SUPER_ADMIN';
    }

    function isKacab() {
      return isRegisteredAndActive() && getUserRole() == 'KACAB';
    }

    function isRM() {
      return isRegisteredAndActive() && getUserRole() == 'RM';
    }

    function isKaops() {
      return isRegisteredAndActive() && getUserRole() == 'KAOPS';
    }

    function isKapos() {
      return isRegisteredAndActive() && getUserRole() == 'KAPOS';
    }

    function isAdm() {
      return isRegisteredAndActive() && getUserRole() == 'ADM';
    }

    function isAdmBpkb() {
      return isRegisteredAndActive() && (getUserRole() == 'ADM_BPKB' || getUserRole() == 'ADMIN_BPKB');
    }

    function isAdmDe() {
      return isRegisteredAndActive() && getUserRole() == 'ADM_DE';
    }

    function isCmo() {
      return isRegisteredAndActive() && getUserRole() == 'CMO';
    }

    // Users collection
    match /users/{userId} {
      allow read: if isRegisteredAndActive();
      allow write: if isSuperAdmin();
    }

    // Cabang & Posko
    match /cabang/{cabangId} {
      allow read: if isRegisteredAndActive();
      allow write: if isSuperAdmin() || isKacab();
    }

    match /posko/{poskoId} {
      allow read: if isRegisteredAndActive();
      allow write: if isSuperAdmin() || isKacab();
    }

    // Mediators
    match /mediator_kontrak/{medId} {
      allow read: if isRegisteredAndActive();
      allow create: if isRegisteredAndActive();
      allow update: if isRegisteredAndActive();
      allow delete: if isSuperAdmin() || isKacab();
    }

    // Ex-Customers
    match /ex_customers/{custDoc} {
      allow read: if isRegisteredAndActive();
      allow create, update: if isRegisteredAndActive();
      allow delete: if isSuperAdmin() || isKacab();
    }

    // Sales Acquisitions
    match /sales_acquisitions/{leadId} {
      allow read: if isRegisteredAndActive();
      allow create: if isRegisteredAndActive();
      allow update: if isRegisteredAndActive();
      allow delete: if isSuperAdmin();
    }

    // Follow ups & Activity logs
    match /activity_logs/{logId} {
      allow read: if isRegisteredAndActive();
      allow create: if isRegisteredAndActive();
      allow update, delete: if isSuperAdmin();
    }

    match /follow_up_logs/{logId} {
      allow read: if isRegisteredAndActive();
      allow create: if isRegisteredAndActive();
      allow update, delete: if isSuperAdmin();
    }
  }
}
